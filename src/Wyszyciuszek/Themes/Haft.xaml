<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== Paleta „stół do szycia”: grafit, len, czerwona nić, drewno tamborka ===================== -->
    <Color x:Key="HaftBg0">#15171A</Color>
    <Color x:Key="HaftBg1">#1C1F23</Color>
    <Color x:Key="HaftBg2">#252A2F</Color>
    <Color x:Key="HaftBg3">#2F353B</Color>
    <Color x:Key="HaftLine">#3A4047</Color>
    <Color x:Key="HaftText">#EEE7D8</Color>
    <Color x:Key="HaftTextDim">#A69F91</Color>
    <Color x:Key="HaftThread">#E2574C</Color>
    <Color x:Key="HaftThreadDark">#B9443B</Color>
    <Color x:Key="HaftWood">#C99B63</Color>
    <Color x:Key="HaftLinen">#E8DFCC</Color>

    <SolidColorBrush x:Key="HaftBg0Brush" Color="{StaticResource HaftBg0}" />
    <SolidColorBrush x:Key="HaftBg1Brush" Color="{StaticResource HaftBg1}" />
    <SolidColorBrush x:Key="HaftBg2Brush" Color="{StaticResource HaftBg2}" />
    <SolidColorBrush x:Key="HaftBg3Brush" Color="{StaticResource HaftBg3}" />
    <SolidColorBrush x:Key="HaftLineBrush" Color="{StaticResource HaftLine}" />
    <SolidColorBrush x:Key="HaftTextBrush" Color="{StaticResource HaftText}" />
    <SolidColorBrush x:Key="HaftTextDimBrush" Color="{StaticResource HaftTextDim}" />
    <SolidColorBrush x:Key="HaftThreadBrush" Color="{StaticResource HaftThread}" />
    <SolidColorBrush x:Key="HaftWoodBrush" Color="{StaticResource HaftWood}" />
    <SolidColorBrush x:Key="HaftLinenBrush" Color="{StaticResource HaftLinen}" />
    <SolidColorBrush x:Key="HaftShadowBrush" Color="#0B0C0E" />

    <!-- nagłówek sekcji panelu: małe litery z odstępami i „przeszyciem” pod spodem -->
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="160" />
        <Setter Property="Foreground" Value="{StaticResource HaftWoodBrush}" />
    </Style>

    <Style x:Key="HintTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource HaftTextDimBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- karta w panelu bocznym -->
    <Style x:Key="PanelCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource HaftBg2Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HaftLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,12,14,14" />
    </Style>

    <!-- pływająca karta nad płótnem -->
    <Style x:Key="FloatingCardStyle" TargetType="Border">
        <Setter Property="Background" Value="#E61C1F23" />
        <Setter Property="BorderBrush" Value="{StaticResource HaftLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <!-- przycisk paska narzędzi -->
    <Style x:Key="BarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- przełącznik narzędzia (pionowa listwa) -->
    <Style x:Key="ToolToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- przełącznik widoku (segmenty) -->
    <Style x:Key="ViewToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="PanelSliderStyle" TargetType="Slider" BasedOn="{StaticResource DefaultSliderStyle}">
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="StepFrequency" Value="1" />
        <Setter Property="TickFrequency" Value="1" />
        <Setter Property="IsThumbToolTipEnabled" Value="True" />
    </Style>

</ResourceDictionary>
