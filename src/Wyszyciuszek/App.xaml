<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Wyszyciuszek.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Themes/Haft.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- akcent: czerwona nić zamiast systemowego niebieskiego -->
            <Color x:Key="SystemAccentColor">#E2574C</Color>
            <Color x:Key="SystemAccentColorLight1">#E87167</Color>
            <Color x:Key="SystemAccentColorLight2">#EE8D85</Color>
            <Color x:Key="SystemAccentColorLight3">#F4ABA5</Color>
            <Color x:Key="SystemAccentColorDark1">#C94A40</Color>
            <Color x:Key="SystemAccentColorDark2">#A83C34</Color>
            <Color x:Key="SystemAccentColorDark3">#862F29</Color>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#EEE7D8" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#BDB5A6" />
                    <SolidColorBrush x:Key="ContentDialogBackground" Color="#1F2327" />
                    <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#272B30" />
                    <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#1F2327" />
                    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#1F2327" />
                    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#1F2327" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#121417" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
