<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Cała logika Wyszyciuszka bez interfejsu: upraszczanie obrazu (kolory, obszary), wektoryzacja konturów,
    układ stron, PDF/SVG, plik projektu, aktualizacje. Bez WinUI i Win2D — testy działają w kilka sekund.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Wyszyciuszek.Core</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Wyszyciuszek.Tests" />
  </ItemGroup>

</Project>
